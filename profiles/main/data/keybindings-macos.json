// Place your key bindings in this file to override the defaults
[
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Find & Replace                                            ║
  // ╚══════════════════════════════════════════════════════════════╝
  // shift+cmd+e = find with selection (swapped from cmd+e)
  {
    "key": "shift+cmd+e",
    "command": "actions.findWithSelection",
  },
  {
    "key": "cmd+e",
    "command": "-actions.findWithSelection",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Explorer Navigation (Vim-style)                           ║
  // ╚══════════════════════════════════════════════════════════════╝
  // cmd+e = open explorer (swapped with shift+cmd+e)
  {
    "key": "cmd+e",
    "command": "workbench.view.explorer",
  },
  {
    "key": "shift+cmd+e",
    "command": "-workbench.view.explorer",
  },
  // j/k = down/up, h = collapse, l/enter = select/open, o = toggle expand
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus",
  },
  {
    "key": "l",
    "command": "list.select",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus",
  },
  {
    "key": "enter",
    "command": "list.select",
    "when": "explorerViewletVisible && filesExplorerFocus",
  },
  {
    "key": "o",
    "command": "list.toggleExpand",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus",
  },
  // r = rename (moved from enter), a = new file, shift+a = new folder
  {
    "key": "r",
    "command": "renameFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "enter",
    "command": "-renameFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && !inputFocus",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Source Control Navigation (Vim-style)                     ║
  // ╚══════════════════════════════════════════════════════════════╝
  // j/k = down/up, h = collapse, l = select/open
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && !inputFocus",
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && !inputFocus",
  },
  {
    "key": "l",
    "command": "list.select",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && !inputFocus",
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && !inputFocus",
  },
  // i or cmd+k = focus commit message input from tree
  {
    "key": "i",
    "command": "workbench.scm.action.focusNextInput",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && !inputFocus",
  },
  {
    "key": "cmd+k",
    "command": "workbench.scm.action.focusNextInput",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && !inputFocus",
  },
  // escape or cmd+j = focus tree from commit message input
  {
    "key": "escape",
    "command": "workbench.scm.action.focusNextResourceGroup",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && inputFocus",
  },
  {
    "key": "cmd+j",
    "command": "workbench.scm.action.focusNextResourceGroup",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && inputFocus",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Search Navigation (Vim-style)                             ║
  // ╚══════════════════════════════════════════════════════════════╝
  // j/k = down/up, h = collapse, l = open result
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "searchViewletFocus && !inputFocus",
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "searchViewletFocus && !inputFocus",
  },
  {
    "key": "l",
    "command": "search.action.openResult",
    "when": "searchViewletFocus && !inputFocus",
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "searchViewletFocus && !inputFocus",
  },
  // i, /, or cmd+k = focus search input from results
  {
    "key": "i",
    "command": "search.action.focusSearchFromResults",
    "when": "searchViewletVisible && hasSearchResult && listFocus",
  },
  {
    "key": "/",
    "command": "search.action.focusSearchFromResults",
    "when": "searchViewletVisible && hasSearchResult && listFocus",
  },
  {
    "key": "cmd+k",
    "command": "search.action.focusSearchFromResults",
    "when": "searchViewletVisible && hasSearchResult && listFocus",
  },
  // escape or cmd+j = focus results list from search input
  {
    "key": "escape",
    "command": "search.action.focusSearchList",
    "when": "searchViewletFocus && inputFocus",
  },
  {
    "key": "cmd+j",
    "command": "search.action.focusSearchList",
    "when": "searchViewletFocus && inputFocus",
  },
  // shift+cmd+h = toggle replace in search view
  {
    "key": "shift+cmd+h",
    "command": "closeReplaceInFilesWidget",
    "when": "searchViewletFocus && replaceActive",
  },
  {
    "key": "shift+cmd+h",
    "command": "workbench.action.replaceInFiles",
    "when": "searchViewletFocus && !replaceActive",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Autocomplete & Suggestions                                ║
  // ╚══════════════════════════════════════════════════════════════╝
  // cmd+j or tab = next suggestion, shift+tab = previous
  {
    "key": "cmd+j",
    "command": "selectNextSuggestion",
    "when": "editorTextFocus && suggestWidgetMultipleSuggestions && suggestWidgetVisible",
  },
  {
    "key": "tab",
    "command": "selectNextSuggestion",
    "when": "editorTextFocus && suggestWidgetMultipleSuggestions && suggestWidgetVisible",
  },
  {
    "key": "shift+tab",
    "command": "selectPrevSuggestion",
    "when": "editorTextFocus && suggestWidgetMultipleSuggestions && suggestWidgetVisible",
  },
  {
    "key": "shift+tab",
    "command": "-acceptAlternativeSelectedSuggestion",
    "when": "suggestWidgetVisible && textInputFocus && textInputFocus",
  },
  // Quick open navigation
  {
    "key": "cmd+j",
    "command": "workbench.action.quickOpenNavigateNext",
    "when": "inQuickOpen",
  },
  {
    "key": "tab",
    "command": "workbench.action.quickOpenNavigateNext",
    "when": "inQuickOpen",
  },
  // shift+; = insert previous suggestion (tab completion)
  {
    "key": "shift+;",
    "command": "insertPrevSuggestion",
    "when": "hasOtherSuggestions && textInputFocus && textInputFocus && !inSnippetMode && !suggestWidgetVisible && config.editor.tabCompletion == 'on'",
  },
  {
    "key": "cmd+space",
    "command": "-editor.action.triggerSuggest",
    "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Window, Panel & Group Navigation (cmd+h/j/k/l)           ║
  // ╚══════════════════════════════════════════════════════════════╝
  // -- Vertical: cmd+j (down) / cmd+k (up) --
  {
    "key": "cmd+j",
    "command": "workbench.action.focusBelowGroup",
    "when": "editorTextFocus && dance.mode != 'insert' && !activeEditorGroupLast",
  },
  {
    "key": "cmd+j",
    "command": "workbench.action.focusPanel",
    "when": "editorTextFocus && dance.mode != 'insert' && activeEditorGroupLast",
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.focusAboveGroup",
    "when": "editorTextFocus && dance.mode != 'insert'",
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus",
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "panelFocus && !terminalFocus",
  },
  // -- Horizontal: cmd+h (left) / cmd+l (right) --
  // Normal editor group navigation (ordered BEFORE diff so diff wins when applicable)
  {
    "key": "cmd+l",
    "command": "workbench.action.focusRightGroup",
    "when": "editorTextFocus && dance.mode != 'insert' && !activeEditorGroupLast",
  },
  {
    "key": "cmd+l",
    "command": "workbench.action.focusAuxiliaryBar",
    "when": "editorTextFocus && dance.mode != 'insert' && activeEditorGroupLast",
  },
  {
    "key": "cmd+h",
    "command": "workbench.action.focusLeftGroup",
    "when": "editorTextFocus && dance.mode != 'insert'",
  },
  {
    "key": "cmd+h",
    "command": "workbench.action.focusSideBar",
    "when": "editorTextFocus && dance.mode != 'insert' && activeEditorGroupIndex == 1",
  },
  // Diff editor: switch between left/right sides (only when actually side-by-side, not inline)
  {
    "key": "cmd+l",
    "command": "workbench.action.compareEditor.focusOtherSide",
    "when": "editorTextFocus && dance.mode != 'insert' && isInDiffEditor && !diffEditorRenderSideBySideInlineBreakpointReached && !isInDiffRightEditor",
  },
  {
    "key": "cmd+h",
    "command": "workbench.action.compareEditor.focusOtherSide",
    "when": "editorTextFocus && dance.mode != 'insert' && isInDiffEditor && !diffEditorRenderSideBySideInlineBreakpointReached && isInDiffRightEditor",
  },
  // Sidebar / auxiliary bar escape hatches
  {
    "key": "cmd+l",
    "when": "sideBarFocus",
    "command": "workbench.action.focusFirstEditorGroup",
  },
  {
    "key": "cmd+h",
    "command": "workbench.action.focusLastEditorGroup",
    "when": "auxiliaryBarFocus",
  },
  {
    "key": "cmd+l",
    "command": "-expandLineSelection",
    "when": "textInputFocus",
  },
  {
    "key": "cmd+j",
    "command": "-workbench.action.togglePanel",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Editor Tab Navigation                                     ║
  // ╚══════════════════════════════════════════════════════════════╝
  {
    "key": "cmd+alt+l",
    "command": "workbench.action.nextEditor",
  },
  {
    "key": "cmd+alt+h",
    "command": "workbench.action.previousEditor",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Terminal                                                   ║
  // ╚══════════════════════════════════════════════════════════════╝
  {
    "key": "alt+j",
    "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus",
  },
  // shift+cmd+c = copy (universal), shift+cmd+v = paste
  {
    "key": "shift+cmd+c",
    "command": "editor.action.clipboardCopyAction",
    "when": "!terminalFocus",
  },
  {
    "key": "shift+cmd+c",
    "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected",
  },
  {
    "key": "shift+cmd+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus",
  },
  {
    "key": "shift+cmd+c",
    "command": "-workbench.action.terminal.openNativeConsole",
    "when": "!terminalFocus"
  },
  // ── Cmd → Ctrl (match Alacritty: Cmd sends control characters) ──
  // Kept as-is: cmd+h/j/k/l (navigation), cmd+f (terminal find),
  //   cmd+i/o (navigate fwd/back), cmd+p (quick open), cmd+q (quit),
  //   cmd+s (save — Ctrl+S would freeze terminal), cmd+m (= Enter, redundant)
  // cmd+a → Ctrl+A (beginning of line)            [shadows: select all in terminal]
  {
    "key": "cmd+a",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0001"
    },
    "when": "terminalFocus",
  },
  // cmd+b → Ctrl+B (back one character)           [shadows: toggle sidebar]
  {
    "key": "cmd+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0002"
    },
    "when": "terminalFocus",
  },
  // cmd+c → Ctrl+C (interrupt/SIGINT)             [shadows: terminal copy — use shift+cmd+c]
  {
    "key": "cmd+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0003"
    },
    "when": "terminalFocus",
  },
  // cmd+d → Ctrl+D (EOF / exit)
  {
    "key": "cmd+d",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0004"
    },
    "when": "terminalFocus",
  },
  // cmd+e → Ctrl+E (end of line)                  [shadows: open explorer]
  {
    "key": "cmd+e",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0005"
    },
    "when": "terminalFocus",
  },
  // cmd+g → Ctrl+G (abort)                        [shadows: go to line]
  {
    "key": "cmd+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0007"
    },
    "when": "terminalFocus",
  },
  // cmd+n → Ctrl+N (next history item)            [shadows: new file]
  {
    "key": "cmd+n",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u000e"
    },
    "when": "terminalFocus",
  },
  // cmd+r → Ctrl+R (reverse history search)
  {
    "key": "cmd+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0012"
    },
    "when": "terminalFocus",
  },
  // cmd+t → Ctrl+T (transpose characters)         [shadows: go to symbol]
  {
    "key": "cmd+t",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0014"
    },
    "when": "terminalFocus",
  },
  // cmd+u → Ctrl+U (kill line backward)
  {
    "key": "cmd+u",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0015"
    },
    "when": "terminalFocus",
  },
  // cmd+v → Ctrl+V (literal insert next char)     [shadows: paste — use shift+cmd+v]
  {
    "key": "cmd+v",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0016"
    },
    "when": "terminalFocus",
  },
  // cmd+w → Ctrl+W (delete word backward)         [shadows: close editor]
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0017"
    },
    "when": "terminalFocus",
  },
  // cmd+x → Ctrl+X (command prefix in emacs mode) [shadows: cut]
  {
    "key": "cmd+x",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0018"
    },
    "when": "terminalFocus",
  },
  // cmd+y → Ctrl+Y (yank / paste in readline)     [shadows: redo]
  {
    "key": "cmd+y",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0019"
    },
    "when": "terminalFocus",
  },
  // cmd+z → Ctrl+Z (suspend / background job)     [shadows: undo]
  {
    "key": "cmd+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001a"
    },
    "when": "terminalFocus",
  },
  // ── Special key sequences (match Alacritty) ──
  // shift+enter → ESC+Enter (multi-line editing in some shells)
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus",
  },
  // alt+right → forward word, alt+left → backward word
  {
    "key": "alt+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001bf"
    },
    "when": "terminalFocus",
  },
  {
    "key": "alt+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001bb"
    },
    "when": "terminalFocus",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  File Open & History Navigation                            ║
  // ╚══════════════════════════════════════════════════════════════╝
  // cmd+o = navigate back, cmd+i = navigate forward
  {
    "key": "cmd+o",
    "command": "workbench.action.navigateBack",
    "when": "canNavigateBack",
  },
  {
    "key": "ctrl+o",
    "command": "-workbench.action.navigateBack",
    "when": "canNavigateBack",
  },
  {
    "key": "cmd+i",
    "command": "workbench.action.navigateForward",
    "when": "canNavigateForward",
  },
  {
    "key": "ctrl+i",
    "command": "-workbench.action.navigateForward",
    "when": "canNavigateForward",
  },
  // File open remapped to shift+cmd+o (freeing cmd+o for nav back)
  {
    "key": "shift+cmd+o",
    "command": "workbench.action.files.openFile",
    "when": "false",
  },
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openFile",
    "when": "false",
  },
  {
    "key": "shift+cmd+o",
    "command": "workbench.action.files.openFolderViaWorkspace",
    "when": "!openFolderWorkspaceSupport && workbenchState == 'workspace'",
  },
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openFolderViaWorkspace",
    "when": "!openFolderWorkspaceSupport && workbenchState == 'workspace'",
  },
  {
    "key": "shift+cmd+o",
    "command": "workbench.action.files.openFileFolder",
    "when": "isMacNative && openFolderWorkspaceSupport",
  },
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openFileFolder",
    "when": "isMacNative && openFolderWorkspaceSupport",
  },
  {
    "key": "shift+cmd+o",
    "command": "workbench.action.files.openLocalFileFolder",
    "when": "remoteFileDialogVisible",
  },
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openLocalFileFolder",
    "when": "remoteFileDialogVisible",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Copilot & Chat                                            ║
  // ╚══════════════════════════════════════════════════════════════╝
  // cmd+space = open chat (in editor) / Ctrl+Space (terminal) / focus editor (elsewhere)
  {
    "key": "cmd+space",
    "command": "workbench.action.chat.open",
    "when": "editorTextFocus",
  },
  // cmd+space → Ctrl+Space (set-mark / tmux prefix)  [was: dance space menu]
  {
    "key": "cmd+space",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0000"
    },
    "when": "terminalFocus",
  },
  {
    "key": "cmd+space",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorTextFocus && !terminalFocus",
  },
  // cmd+enter = submit chat (instead of enter)
  {
    "key": "cmd+enter",
    "command": "workbench.action.chat.submit",
    "when": "inChatInput && textInputFocus",
  },
  {
    "key": "enter",
    "command": "-workbench.action.chat.submit",
  },
  // cmd+j = focus chat input when inside chat
  {
    "key": "cmd+j",
    "command": "workbench.action.chat.focusInput",
    "when": "inChat && !editorFocus",
  },
  // shift+cmd+k = attach selection to chat
  {
    "key": "shift+cmd+k",
    "command": "github.copilot.chat.attachSelection",
  },
  {
    "key": "shift+cmd+k",
    "command": "-editor.action.deleteLines",
    "when": "textInputFocus && !editorReadonly",
  },
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  Dance Mode (Kakoune-style editing)                        ║
  // ╚══════════════════════════════════════════════════════════════╝
  // -- Command palette via shift+; (normal/visual) or cmd+; (outside editor) --
  {
    "key": "shift+;",
    "command": "dance.openMenu",
    "args": {
      "menu": "command",
    },
    "when": "editorTextFocus && dance.mode == 'normal'",
  },
  {
    "key": "shift+;",
    "command": "dance.openMenu",
    "args": {
      "menu": "command",
    },
    "when": "editorTextFocus && dance.mode == 'visual'",
  },
  {
    "key": "cmd+;",
    "command": "dance.openMenu",
    "args": {
      "menu": "command",
    },
    "when": "!editorTextFocus",
  },
  // -- Find: / = open find dialog (replaces dance.search) --
  {
    "key": "/",
    "command": "-dance.search",
    "when": "editorTextFocus && dance.mode == 'normal'",
  },
  {
    "key": "/",
    "command": "-dance.search",
    "when": "editorTextFocus && dance.mode == 'visual'",
  },
  {
    "key": "/",
    "command": "actions.find",
    "when": "editorTextFocus && dance.mode == 'normal'",
  },
  {
    "key": "/",
    "command": "actions.find",
    "when": "editorTextFocus && dance.mode == 'visual'",
  },
  // -- Line selection: x = select line + expand to full lines --
  {
    "key": "x",
    "command": "-dance.select.line.below.extend",
    "when": "editorTextFocus && dance.mode == 'visual'",
  },
  {
    "key": "x",
    "command": "runCommands",
    "args": {
      "commands": [
        "dance.select.line.below.extend",
        "dance.selections.expandToLines",
      ],
    },
    "when": "editorTextFocus && dance.mode == 'visual'",
  },
  // -- Yank: y = copy selection + return to normal mode --
  {
    "key": "y",
    "command": "-dance.selections.saveText",
    "when": "editorTextFocus && dance.mode == 'visual'",
  },
  {
    "key": "y",
    "command": "runCommands",
    "args": {
      "commands": [
        "dance.selections.saveText",
        "dance.modes.set.normal"
      ],
    },
    "when": "editorTextFocus && dance.mode == 'visual'",
  },
  // -- Escape: clear selections / reduce cursors in normal mode --
  {
    "key": "escape",
    "command": "removeSecondaryCursors",
    "when": "editorHasMultipleSelections && textInputFocus && dance.mode == 'normal'",
  },
  {
